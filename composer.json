{
    "name": "flairuk/laravel-starlink",
    "description": "Starlink for Laravel: poll the device telemetry stream, decode its column-indexed rows, resolve alerts into raised and cleared events, and read the latest values per terminal and router.",
    "keywords": [
        "laravel",
        "starlink",
        "telemetry",
        "satellite",
        "monitoring",
        "alerts",
        "iot"
    ],
    "homepage": "https://github.com/FLAIRUK/laravel-starlink",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Phil Graham",
            "homepage": "https://github.com/ijeffro",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "FLAIRUK\\Starlink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FLAIRUK\\Starlink\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "FLAIRUK\\Starlink\\StarlinkServiceProvider"
            ],
            "aliases": {
                "Starlink": "FLAIRUK\\Starlink\\Facades\\Starlink"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
